# Minimal Doxygen configuration for this template. Unlisted tags keep
# Doxygen's defaults. Generated from this template by cmake/Doxygen.cmake;
# the two @PAIRRING_DOXYGEN_*@ placeholders below are the only things that
# differ between the 'docs' and 'docs-check' targets.

PROJECT_NAME           = "pairring"
PROJECT_NUMBER         = "@PAIRRING_VERSION@"
PROJECT_BRIEF          = "Point-to-point message channel over remotely writable memory"
OUTPUT_DIRECTORY       = "@PAIRRING_DOXYGEN_OUTPUT_DIR@"

INPUT                  = "@PAIRRING_SOURCE_DIR@/include" \
                          "@PAIRRING_SOURCE_DIR@/docs/mainpage.md"
EXCLUDE_SYMBOLS        = pairring::detail
FILE_PATTERNS           = *.hpp *.h *.md
RECURSIVE               = YES
EXCLUDE_PATTERNS        = */_deps/* */tests/* */build/*
USE_MDFILE_AS_MAINPAGE  = "@PAIRRING_SOURCE_DIR@/docs/mainpage.md"
STRIP_FROM_PATH         = "@PAIRRING_SOURCE_DIR@"

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = @PAIRRING_DOXYGEN_WARN_AS_ERROR@

GENERATE_HTML           = @PAIRRING_DOXYGEN_GENERATE_HTML@
GENERATE_LATEX          = NO
GENERATE_XML            = NO
SOURCE_BROWSER          = YES
HAVE_DOT                = @PAIRRING_DOXYGEN_HAVE_DOT@
QUIET                   = YES
